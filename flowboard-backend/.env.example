FLOWBOARD_SECRET_KEY=replace-with-a-long-random-value
# SQLite (default)
FLOWBOARD_DATABASE_URL=sqlite:///./data/flowboard.db
# PostgreSQL: postgresql+psycopg://user:password@localhost:5432/flowboard
# MySQL: mysql+pymysql://user:password@localhost:3306/flowboard?charset=utf8mb4
FLOWBOARD_DATABASE_POOL_SIZE=10
FLOWBOARD_DATABASE_MAX_OVERFLOW=20
FLOWBOARD_DATABASE_POOL_RECYCLE_SECONDS=1800
FLOWBOARD_UPLOAD_DIR=./data/uploads
FLOWBOARD_CORS_ORIGINS=http://localhost:3000
